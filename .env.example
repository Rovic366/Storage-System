# Copy to .env and adjust. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=UTC

# PostgreSQL (optional - leave empty to use SQLite in development)
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Seed credentials (development/demo only - change before real use)
SEED_PASSWORD=demo1234
